rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny-all catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'farihatuz.zaidah.2402316@students.um.ac.id' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'displayName', 'role']) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
        data.role in ['pelajar', 'guru', 'admin'];
    }

    function isValidWriting(data) {
      return data.keys().hasAll(['userId', 'title', 'category', 'arabicText']) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.title is string && data.title.size() <= 200 &&
        data.arabicText is string && data.arabicText.size() <= 10000 &&
        data.category in ['insha_hurr', 'insha_muwajjah', 'imla', 'tarkib', 'khat'];
    }

    function isValidProgress(data) {
      return data.keys().hasAll(['userId', 'drillType', 'drillId', 'isCompleted']) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.drillType in ['tarkib', 'imla_faragh', 'dikte', 'khat_tracing'] &&
        data.drillId is string && data.drillId.size() <= 100 &&
        data.isCompleted is bool;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(request.resource.data);
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUser(request.resource.data);
      allow delete: if false;
    }

    // Student writing compositions and essays
    match /writings/{writingId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidWriting(request.resource.data);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidWriting(request.resource.data);
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Interactive drill progress
    match /practice_progress/{progressId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidProgress(request.resource.data);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidProgress(request.resource.data);
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Test connection doc
    match /test/connection {
      allow read: if true;
    }
  }
}
